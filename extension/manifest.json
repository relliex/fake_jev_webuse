{
  "manifest_version": 3,
  "name": "Fake-JEV WebUse: 极速浏览器操作插件",
  "version": "1.0.0",
  "description": "基于通用大模型 + 外部工程护栏复现 Jev 只做决策不生成文本的高频极速网页操作",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8789/*",
    "http://localhost:8789/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "打开 Fake-JEV 控制台"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
