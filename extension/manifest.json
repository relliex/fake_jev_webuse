{
  "manifest_version": 3,
  "name": "Lite-JEV: Zero-CoT 极速浏览器操作插件",
  "version": "1.0.0",
  "description": "基于原版模型 API + 严格 Harness + 零思考 (Zero-CoT) 实现毫秒级端到端网页自主操作",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8789/*",
    "http://localhost:8789/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "打开 Lite-JEV 控制台"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
